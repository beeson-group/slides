# Matplotlib style for figures on the light theme of the Beeson slides. Load it with
# plt.style.use('styles/beeson-light.mplstyle'). The backgrounds are transparent, hence the slide
# shows through, and line widths are 1.8 times the defaults of Matplotlib.

figure.facecolor: none
axes.facecolor: none
savefig.facecolor: none
savefig.transparent: True
savefig.dpi: 200
figure.figsize: 8, 4.5
# with constrained layout, the labels of 18 pt text are fitted inside the figure at its set size
figure.constrained_layout.use: True

# STIXGeneral, which ships with Matplotlib, is used where STIX Two Text is not installed
font.family: serif
font.serif: STIX Two Text, STIXGeneral, DejaVu Serif
mathtext.fontset: stix
font.size: 18

text.color: 141413
axes.labelcolor: 141413
axes.titlecolor: 141413
axes.edgecolor: 55554f
xtick.color: 55554f
ytick.color: 55554f
xtick.labelcolor: 141413
ytick.labelcolor: 141413
grid.color: e3e0d8

lines.linewidth: 2.7
axes.linewidth: 1.44
grid.linewidth: 1.44
xtick.major.width: 1.44
ytick.major.width: 1.44
xtick.minor.width: 1.08
ytick.minor.width: 1.08

axes.spines.top: False
axes.spines.right: False
legend.frameon: False

# the Okabe-Ito palette for color vision deficiency, with the text color in place of black
axes.prop_cycle: cycler('color', ['E69F00', '56B4E9', '009E73', 'F0E442', '0072B2', 'D55E00', 'CC79A7', '141413'])
